# Bedrock (standard AWS credential chain also works: profiles, SSO, etc.)
AWS_REGION=us-east-1
# Override the two tiers if you like. Prices in escalator/pricing.py must match.
ESCALATOR_SMALL_MODEL=us.amazon.nova-micro-v1:0
ESCALATOR_LARGE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Where `strands-decider serve` is listening
STRANDS_DECIDER_URL=http://127.0.0.1:8099
